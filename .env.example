# Copy to .env.local (never commit it). On Vercel, add the same names under Project Settings > Environment Variables.

# Required for the contact form to actually send. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Defaults to mazumder.mdfardin@gmail.com
CONTACT_TO_EMAIL=

# Optional. Defaults to "Portfolio <onboarding@resend.dev>", which can only deliver to the email address
# your Resend account was created with. Verify your own domain in Resend to use e.g. "Fardin <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=
